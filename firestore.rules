rules_version = '2';

// Regras de segurança — Pizzaria Delivery
// Leitura pública do cardápio/config/cupons; escrita apenas para admins autenticados.
// Pedidos: qualquer visitante pode CRIAR (checkout público); ler/alterar só autenticado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    function isValidOrder(d) {
      return d.status == 'pending'
        && d.source == 'web'
        && d.total is number && d.total >= 0
        && d.subtotal is number
        && d.items is list && d.items.size() > 0
        && d.customer.name is string && d.customer.name.size() > 0
        && d.customer.phone is string && d.customer.phone.size() >= 8
        && (d.fulfillment == 'delivery' || d.fulfillment == 'pickup')
        && (d.payment.method == 'pix' || d.payment.method == 'card' || d.payment.method == 'cash');
    }

    function onlyIncrementsUsed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1;
    }

    // ---- Cardápio e configuração (leitura pública) ----
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /addons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Cupons ----
    // Leitura pública para validar no checkout. Escrita de admin.
    // O cliente só pode incrementar o campo "used" em +1.
    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyIncrementsUsed();
    }

    // ---- Pedidos ----
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidOrder(request.resource.data);
    }
  }
}
